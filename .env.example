# ─── Base de datos ───────────────────────────────────────────────
# Postgres local via docker-compose (puerto custom para no chocar con otros proyectos)
DATABASE_URL="postgresql://trucazo:trucazo@localhost:54341/trucazo?schema=public"

# ─── Redis (Fase 6+: matchmaking, presencia, adapter Socket.IO) ───
REDIS_URL="redis://localhost:63791"

# ─── Auth ────────────────────────────────────────────────────────
# Secreto para firmar cookies de sesión (>= 32 bytes aleatorios). NO usar este valor en prod.
SESSION_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio-min-32b"
# Secreto para el JWT corto que autentica el handshake del Socket.IO
GAME_TOKEN_SECRET="cambiar-esto-tambien-por-otro-secreto-distinto-32b"

# ─── URLs de servicios ───────────────────────────────────────────
WEB_URL="http://localhost:3000"
GAME_SERVER_URL="http://localhost:4000"
GAME_SERVER_PORT="4000"

# ─── Email (verificación / recuperación) ─────────────────────────
# En dev se loguea a consola si no hay SMTP configurado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Trucazo <no-reply@trucazo.local>"

# ─── Feature flags de arranque ───────────────────────────────────
FEATURE_REAL_MONEY="false"     # dinero real deshabilitado por diseño
FEATURE_TOURNAMENTS="true"
FEATURE_CLUBS="true"

# ─── Economía ────────────────────────────────────────────────────
PLATFORM_RAKE_BPS="500"        # comisión de plataforma en basis points (500 = 5%)
DAILY_BONUS_COINS="100"
NEW_USER_COINS="0"             # sin fichas de regalo: son plata real, se cargan con cajero

# ─── Observabilidad ──────────────────────────────────────────────────────────
# Webhook (Slack/Discord/etc.) donde avisar lo que un humano TIENE que mirar:
# liquidación fallida, apuestas congeladas, partidas huérfanas tras un reinicio.
# Sin esta variable las alertas quedan sólo en el log estructurado.
ALERTAS_WEBHOOK_URL=""

# Cuánto se espera a un jugador que se desconecta en plena partida (ms).
ESPERA_AUSENCIA_MS="180000"
