    "@trucazo/engine": "workspace:*",
    "@trucazo/shared": "workspace:*",
    "fastify": "^5.2.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
