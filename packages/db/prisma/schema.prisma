// Trucazo — modelo de datos.
// Convenciones: ids cuid, timestamps createdAt/updatedAt, enums para estados,
// idempotencyKey en operaciones económicas, ledger append-only (sin updates de
// saldo directos), índices en claves de búsqueda y foráneas.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Cuentas y auth ─────────────────────────────────────────────────────────

enum Role {
  USER
  CASHIER
  MODERATOR
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  passwordHash  String? // scrypt; null para invitados
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  isGuest       Boolean  @default(false)
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())

  profile        Profile?
  wallet         Wallet?
  cashierProfile CashierProfile?
  sessions       Session[]
  ledgerEntries  LedgerEntry[]
  ratings        Rating[]
  sanctions      Sanction[]      @relation("SanctionTarget")

  roomParticipations RoomParticipant[]
  matchPlayers       MatchPlayer[]
  betParticipants    BetParticipant[]
  withdrawals        WithdrawalRequest[] @relation("WithdrawalUser")
  cashierWithdrawals WithdrawalRequest[] @relation("WithdrawalCashier")
  notifications      Notification[]
  reportsMade        Report[]            @relation("Reporter")
  reportsAgainst     Report[]            @relation("Reported")
  auditLogs          AuditLog[]

  friendsInitiated Friendship[]      @relation("FriendFrom")
  friendsReceived  Friendship[]      @relation("FriendTo")
  blocksMade       Block[]           @relation("Blocker")
  blocksReceived   Block[]           @relation("Blocked")
  clubMemberships  ClubMember[]
  achievements     UserAchievement[]
  missions         UserMission[]
  cosmetics        UserCosmetic[]

  @@index([role])
  @@index([lastSeenAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatar      String?
  frame       String?
  country     String?  @default("AR")
  bio         String?
  level       Int      @default(1)
  xp          Int      @default(0)
  privacy     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Economía: wallet + ledger append-only ──────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// Saldo disponible (derivado del ledger; se actualiza atómicamente con cada entry).
  balance   BigInt   @default(0)
  /// Saldo bloqueado (apuestas reservadas, retiros pendientes).
  locked    BigInt   @default(0)
  /// Columna de versión para optimistic locking.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LedgerType {
  CASHIER_DEPOSIT
  CASHIER_WITHDRAWAL
  BET_RESERVED
  BET_WON
  BET_LOST
  BET_REFUND
  RAKE
  DAILY_BONUS
  LEVEL_REWARD
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  ADMIN_ADJUSTMENT
  PENALTY
}

/// Registro contable inmutable. NUNCA se actualiza ni borra; sólo se inserta.
model LedgerEntry {
  id             String     @id @default(cuid())
  userId         String
  type           LedgerType
  /// Delta con signo (positivo acredita, negativo debita).
  amount         BigInt
  balanceBefore  BigInt
  balanceAfter   BigInt
  /// Clave de idempotencia: evita dobles acreditaciones. Única por usuario.
  idempotencyKey String
  reason         String?
  matchId        String?
  tournamentId   String?
  betId          String?
  /// Actor que originó el movimiento (cajero/admin), si aplica.
  actorUserId    String?
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([type])
  @@index([matchId])
}

// ─── Cajeros ────────────────────────────────────────────────────────────────

model CashierProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  whatsappE164   String
  displayName    String
  active         Boolean  @default(true)
  /// Límites configurables.
  perOpMax       BigInt   @default(100000)
  perDayMax      BigInt   @default(1000000)
  /// Totales auditables.
  totalDeposited BigInt   @default(0)
  totalWithdrawn BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active])
}

enum WithdrawalState {
  PENDING
  RESERVED
  PAID
  REJECTED
  CANCELLED_BY_USER
}

model WithdrawalRequest {
  id         String          @id @default(cuid())
  userId     String
  cashierId  String
  amount     BigInt
  state      WithdrawalState @default(PENDING)
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  resolvedAt DateTime?

  user    User @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Cascade)
  cashier User @relation("WithdrawalCashier", fields: [cashierId], references: [id])

  @@index([userId])
  @@index([cashierId, state])
}

// ─── Salas ──────────────────────────────────────────────────────────────────

enum RoomState {
  CREATED
  WAITING
  FULL
  READY_CHECK
  STARTING
  IN_PROGRESS
  PAUSED
  FINISHED
  CANCELLED
  CLOSED
}

enum GameMode {
  CASUAL_1V1
  RANKED_1V1
  CASUAL_2V2
  RANKED_2V2
}

model Room {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  hostUserId      String
  mode            GameMode
  state           RoomState @default(CREATED)
  pointsToWin     Int       @default(30)
  isPrivate       Boolean   @default(false)
  passwordHash    String?
  florEnabled     Boolean   @default(true)
  allowSpectators Boolean   @default(true)
  maxSpectators   Int       @default(20)
  chatEnabled     Boolean   @default(true)
  turnTimeoutSec  Int       @default(30)
  betAmount       BigInt    @default(0)
  minLevel        Int       @default(0)
  allowBots       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participants RoomParticipant[]
  match        Match?

  @@index([state, isPrivate])
  @@index([mode])
}

model RoomParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  seat      Int?
  team      Int?
  ready     Boolean  @default(false)
  isBot     Boolean  @default(false)
  spectator Boolean  @default(false)
  joinedAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
}

// ─── Partidas + event log ────────────────────────────────────────────────────

enum MatchState {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Match {
  id          String     @id @default(cuid())
  roomId      String     @unique
  mode        GameMode
  pointsToWin Int
  florEnabled Boolean
  players     Int
  state       MatchState @default(IN_PROGRESS)
  winnerTeam  Int?
  betAmount   BigInt     @default(0)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  matchPlayers MatchPlayer[]
  events       GameEvent[]
  result       MatchResult?
  bet          Bet?

  @@index([state])
  @@index([startedAt])
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  userId   String
  seat     Int
  team     Int
  isBot    Boolean @default(false)
  botLevel String?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, seat])
  @@index([userId])
}

/// Event log secuenciado: reconstrucción de partidas, replays y auditoría.
model GameEvent {
  id        String   @id @default(cuid())
  matchId   String
  seq       Int
  type      String
  /// Payload completo (server-side). La proyección a cliente se redacta aparte.
  payload   Json
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, seq])
  @@index([matchId])
}

model MatchResult {
  id         String   @id @default(cuid())
  matchId    String   @unique
  winnerTeam Int
  scoreTeam0 Int
  scoreTeam1 Int
  rounds     Int
  createdAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// ─── Apuestas ────────────────────────────────────────────────────────────────

enum BetState {
  OPEN
  RESERVED
  SETTLED
  REFUNDED
  CANCELLED
}

model Bet {
  id        String    @id @default(cuid())
  matchId   String    @unique
  amount    BigInt
  rakeBps   Int       @default(500)
  pot       BigInt    @default(0)
  state     BetState  @default(OPEN)
  createdAt DateTime  @default(now())
  settledAt DateTime?

  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participants BetParticipant[]

  @@index([state])
}

model BetParticipant {
  id        String   @id @default(cuid())
  betId     String
  userId    String
  seat      Int
  confirmed Boolean  @default(false)
  reserved  Boolean  @default(false)
  won       Boolean?

  bet  Bet  @relation(fields: [betId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([betId, userId])
}

// ─── Ranking ─────────────────────────────────────────────────────────────────

enum Division {
  BRONCE
  PLATA
  ORO
  PLATINO
  DIAMANTE
  MAESTRO
  GRAN_MAESTRO
}

model Rating {
  id         String   @id @default(cuid())
  userId     String
  mode       GameMode
  /// Glicko-2.
  rating     Float    @default(1500)
  deviation  Float    @default(350)
  volatility Float    @default(0.06)
  division   Division @default(BRONCE)
  games      Int      @default(0)
  wins       Int      @default(0)
  losses     Int      @default(0)
  abandons   Int      @default(0)
  updatedAt  DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  history RatingHistory[]

  @@unique([userId, mode])
  @@index([mode, rating])
}

model RatingHistory {
  id        String   @id @default(cuid())
  ratingId  String
  matchId   String?
  before    Float
  after     Float
  createdAt DateTime @default(now())

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@index([ratingId, createdAt])
}

model Season {
  id        String   @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Social ──────────────────────────────────────────────────────────────────

enum FriendState {
  PENDING
  ACCEPTED
}

model Friendship {
  id        String      @id @default(cuid())
  fromId    String
  toId      String
  state     FriendState @default(PENDING)
  createdAt DateTime    @default(now())

  from User @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Club {
  id          String       @id @default(cuid())
  name        String       @unique
  tag         String       @unique
  description String?
  crest       String?
  createdAt   DateTime     @default(now())
  members     ClubMember[]
}

enum ClubRole {
  MEMBER
  OFFICER
  LEADER
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

// ─── Torneos ─────────────────────────────────────────────────────────────────

enum TournamentFormat {
  SINGLE_ELIM
  DOUBLE_ELIM
  GROUPS_PLAYOFF
}

enum TournamentState {
  DRAFT
  REGISTRATION
  CHECK_IN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Tournament {
  id         String           @id @default(cuid())
  name       String
  format     TournamentFormat @default(SINGLE_ELIM)
  mode       GameMode
  state      TournamentState  @default(DRAFT)
  entryFee   BigInt           @default(0)
  maxPlayers Int              @default(16)
  startsAt   DateTime?
  createdAt  DateTime         @default(now())

  participants TournamentParticipant[]
  matches      TournamentMatch[]
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  checkedIn    Boolean  @default(false)
  eliminated   Boolean  @default(false)
  placement    Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int
  slot         Int
  matchId      String?
  winnerUserId String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
}

// ─── Progresión y cosméticos ──────────────────────────────────────────────────

model Achievement {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String
  icon        String?

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

enum MissionPeriod {
  DAILY
  WEEKLY
}

model Mission {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String
  period      MissionPeriod
  target      Int
  rewardCoins Int           @default(0)
  rewardXp    Int           @default(0)

  users UserMission[]
}

model UserMission {
  id        String    @id @default(cuid())
  userId    String
  missionId String
  progress  Int       @default(0)
  completed Boolean   @default(false)
  claimedAt DateTime?
  periodKey String // p.ej. "2026-07-23" o "2026-W30"

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, periodKey])
}

enum CosmeticKind {
  CARD_DESIGN
  CARD_BACK
  TABLE
  MAT
  AVATAR
  FRAME
  BADGE
  EMOJI
  TITLE
}

model Cosmetic {
  id         String       @id @default(cuid())
  code       String       @unique
  kind       CosmeticKind
  name       String
  priceCoins Int          @default(0)
  asset      String?

  owners UserCosmetic[]
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  cosmeticId String
  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
}

// ─── Moderación, notificaciones, auditoría ────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum ReportState {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id          String      @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      String
  detail      String?
  matchId     String?
  state       ReportState @default(OPEN)
  moderatorId String?
  resolution  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([state])
}

enum SanctionType {
  WARNING
  MUTE
  SUSPENSION
  BAN
}

model Sanction {
  id        String       @id @default(cuid())
  userId    String
  type      SanctionType
  reason    String
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  user User @relation("SanctionTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Registro inmutable de acciones administrativas y de cajero.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String?
  data      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
